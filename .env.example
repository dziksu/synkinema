# Docker Compose defaults to this machine only.
SYNKINEMA_BIND_HOST=127.0.0.1
# For trusted LAN access: set bind host to 0.0.0.0 and list the machine's LAN IP.
SYNKINEMA_ALLOWED_HOSTS=
# For compose.release.yaml, set this to a published version to pin deployments.
# SYNKINEMA_IMAGE=ghcr.io/dziksu/synkinema:v1.0.0

# Server-only options can be passed via Compose environment or the process env.
# SYNKINEMA_API_TOKEN protects /api and /mcp, not media files; Studio has no login.
# Never commit real ElevenLabs keys, tokens, database files or private media.
