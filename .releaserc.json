{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "build", "scope": "deps", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "perf", "section": "Performance" },
            { "type": "build", "section": "Build and Dependencies" }
          ]
        }
      }
    ],
    "./scripts/release/prepare.mjs",
    [
      "@semantic-release/github",
      {
        "successCommentCondition": false,
        "failCommentCondition": false,
        "releasedLabels": false,
        "assets": [
          {
            "path": ".release/compose.release.yaml",
            "label": "Docker Compose deployment"
          },
          {
            "path": ".release/openapi.json",
            "label": "OpenAPI contract for this release"
          },
          {
            "path": ".release/release.json",
            "label": "Release version and source commit"
          },
          { "path": "THIRD_PARTY_NOTICES.md", "label": "Third-party notices" },
          { "path": "LICENSE", "label": "MIT license" }
        ]
      }
    ]
  ]
}
